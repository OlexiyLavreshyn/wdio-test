{
    "name": "saucedemo",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@wdio/allure-reporter": "^9.27.0",
        "@wdio/cli": "^9.27.0",
        "@wdio/local-runner": "^9.27.0",
        "@wdio/mocha-framework": "^9.27.0",
        "@wdio/spec-reporter": "^9.27.0",
        "allure-commandline": "^2.38.1",
        "eslint": "^10.9.1",
        "eslint-plugin-wdio": "^9.31.3",
        "prettier": "^3.9.6",
        "wdio-wait-for": "^3.1.1"
    },
    "scripts": {
        "test": "wdio run src/config/wdio.conf.js",
        "allure:generate": "npx allure generate allure-results --clean -o allure-report",
        "allure:open": "npx allure open allure-report",
        "allure:serve": "npx allure generate allure-results --clean -o allure-report && allure open allure-report",
        "lint:format": "prettier --check .",
        "lint:code": "eslint .",
        "lint": "npm run lint:format && npm run lint:code"
